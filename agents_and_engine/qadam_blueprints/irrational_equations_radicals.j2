{% macro x_plus_c(c) -%}
x{%- if c > 0 %}+{{ c }}{%- elif c < 0 %}-{{ -c }}{%- endif -%}
{%- endmacro %}

{% macro ax_plus_b(a, b) -%}
{%- if a == 1 -%}x
{%- elif a == -1 -%}-x
{%- else -%}{{ a }}x
{%- endif -%}
{%- if b > 0 %}+{{ b }}
{%- elif b < 0 %}-{{ -b }}
{%- endif -%}
{%- endmacro %}

{% macro const_minus_x(c) -%}
{%- if c > 0 -%}{{ c }}-x
{%- elif c < 0 -%}-{{ -c }}-x
{%- else -%}-x
{%- endif -%}
{%- endmacro %}

{% macro poly2(a, b, c) -%}
{%- if a == 1 -%}x^2
{%- elif a == -1 -%}-x^2
{%- else -%}{{ a }}x^2
{%- endif -%}
{%- if b > 0 %}+{% if b != 1 %}{{ b }}{% endif %}x
{%- elif b < 0 %}-{% if b != -1 %}{{ -b }}{% endif %}x
{%- endif -%}
{%- if c > 0 %}+{{ c }}
{%- elif c < 0 %}-{{ -c }}
{%- endif -%}
{%- endmacro %}

{% macro nthroot(n, body) -%}
{%- if n == 2 -%}\sqrt{ {{ body }} }
{%- else -%}\sqrt[{{ n }}]{ {{ body }} }
{%- endif -%}
{%- endmacro %}

