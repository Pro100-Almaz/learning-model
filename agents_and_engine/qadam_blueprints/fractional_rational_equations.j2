{% macro lin_minus(v) -%}
{%- if v == 0 -%}x
{%- elif v > 0 -%}x-{{ v }}
{%- else -%}x+{{ -v }}
{%- endif -%}
{%- endmacro %}

{% macro lin_plus(v) -%}
{%- if v == 0 -%}x
{%- elif v > 0 -%}x+{{ v }}
{%- else -%}x-{{ -v }}
{%- endif -%}
{%- endmacro %}

{% macro poly2(a, b, c) -%}
{%- if a == 1 -%}x^2
{%- elif a == -1 -%}-x^2
{%- else -%}{{ a }}x^2
{%- endif -%}
{%- if b > 0 %}+{% if b != 1 %}{{ b }}{% endif %}x
{%- elif b < 0 %}-{% if b != -1 %}{{ -b }}{% endif %}x
{%- endif -%}
{%- if c > 0 %}+{{ c }}
{%- elif c < 0 %}-{{ -c }}
{%- endif -%}
{%- endmacro %}

{% macro signed_const(v) -%}
{%- if v > 0 %}+{{ v }}{%- elif v < 0 %}-{{ -v }}{%- endif -%}
{%- endmacro %}

