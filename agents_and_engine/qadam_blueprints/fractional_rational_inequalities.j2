{% macro lin_minus(v) -%}
{%- if v == 0 -%}x
{%- elif v > 0 -%}x-{{ v }}
{%- else -%}x+{{ -v }}
{%- endif -%}
{%- endmacro %}

{% macro poly2(a, b, c) -%}
{%- if a == 1 -%}x^2
{%- elif a == -1 -%}-x^2
{%- else -%}{{ a }}x^2
{%- endif -%}
{%- if b > 0 %}+{% if b != 1 %}{{ b }}{% endif %}x
{%- elif b < 0 %}-{% if b != -1 %}{{ -b }}{% endif %}x
{%- endif -%}
{%- if c > 0 %}+{{ c }}
{%- elif c < 0 %}-{{ -c }}
{%- endif -%}
{%- endmacro %}

{% macro poly3(a, b, c, d) -%}
{%- if a == 1 -%}x^3
{%- elif a == -1 -%}-x^3
{%- else -%}{{ a }}x^3
{%- endif -%}
{%- if b > 0 %}+{% if b != 1 %}{{ b }}{% endif %}x^2
{%- elif b < 0 %}-{% if b != -1 %}{{ -b }}{% endif %}x^2
{%- endif -%}
{%- if c > 0 %}+{% if c != 1 %}{{ c }}{% endif %}x
{%- elif c < 0 %}-{% if c != -1 %}{{ -c }}{% endif %}x
{%- endif -%}
{%- if d > 0 %}+{{ d }}
{%- elif d < 0 %}-{{ -d }}
{%- endif -%}
{%- endmacro %}

