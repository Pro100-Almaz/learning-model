{% macro sparse(a, p, b, q, c) -%}
{%- if a == 1 -%}x^{{ p }}
{%- elif a == -1 -%}-x^{{ p }}
{%- else -%}{{ a }}x^{{ p }}
{%- endif -%}
{%- if b > 0 %} + {% if b != 1 %}{{ b }}{% endif %}x^{{ q }}
{%- elif b < 0 %} - {% if b != -1 %}{{ -b }}{% endif %}x^{{ q }}
{%- endif -%}
{%- if c > 0 %} + {{ c }}
{%- elif c < 0 %} - {{ -c }}
{%- endif -%}
{%- endmacro %}

{% macro two_terms(a, p, b) -%}
{%- if a == 1 -%}x^{{ p }}
{%- elif a == -1 -%}-x^{{ p }}
{%- else -%}{{ a }}x^{{ p }}
{%- endif -%}
{%- if b > 0 %} + {% if b != 1 %}{{ b }}{% endif %}x
{%- elif b < 0 %} - {% if b != -1 %}{{ -b }}{% endif %}x
{%- endif -%}
{%- endmacro %}

{% macro shifted(shift) -%}
{%- if shift > 0 -%}(x+{{ shift }})
{%- elif shift < 0 -%}(x-{{ -shift }})
{%- else -%}x
{%- endif -%}
{%- endmacro %}

{% macro factor(root) -%}
{%- if root > 0 -%}(x-{{ root }})
{%- elif root < 0 -%}(x+{{ -root }})
{%- else -%}x
{%- endif -%}
{%- endmacro %}

{% macro quad(b, c) -%}
x^2{%- if b == 1 %}+x{%- elif b == -1 %}-x{%- elif b > 0 %}+{{ b }}x{%- elif b < 0 %}-{{ -b }}x{%- endif -%}{%- if c > 0 %}+{{ c }}{%- elif c < 0 %}-{{ -c }}{%- endif -%}
{%- endmacro %}

