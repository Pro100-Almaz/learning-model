{
  "topic": "inequalities",
  "display_name": "Linear, quadratic, rational, trigonometric, irrational, exponential and logarithmic inequalities",
  "curriculum_ref": "KZ 2026 UBT — Inequalities — Topic 10",
  "constraints_template": "ubt_inequalities.j2",
  "_comment": "Deterministic inequality generator. Difficulty is controlled by the structure of the inequality and the number of transformations required, not mainly by coefficient size. Python/SymPy owns generation, solving, interval/set validation, domain checks, and distractor filtering. Jinja only renders prepared question data.",
  "tag": {
    "name": "Теңсіздіктер",
    "slug": "tensizdikter"
  },
  "default_difficulty": 1,
  "expression_language": "sympy",
  "parameters": {
    "mode": {
      "type": "choice",
      "values": [
        "linear_direct",
        "exponential_same_base",
        "logarithmic_linear",
        "quadratic_between_roots",
        "trig_sine_interval",
        "irrational_root_bound",
        "quadratic_outside_roots",
        "rational_sign_chart",
        "exponential_quadratic_substitution",
        "logarithmic_squared"
      ]
    },
    "a": {
      "type": "int",
      "min": 1,
      "max": 7
    },
    "b": {
      "type": "int",
      "min": -8,
      "max": 8
    },
    "threshold": {
      "type": "int",
      "min": -8,
      "max": 8
    },
    "r1": {
      "type": "int",
      "min": -7,
      "max": 4
    },
    "r2": {
      "type": "int",
      "min": -3,
      "max": 8
    },
    "alpha": {
      "type": "choice",
      "values": [
        30,
        45,
        60
      ]
    },
    "shift": {
      "type": "int",
      "min": -5,
      "max": 5
    },
    "p": {
      "type": "int",
      "min": 1,
      "max": 6
    },
    "base": {
      "type": "choice",
      "values": [
        2,
        3,
        4,
        5
      ]
    },
    "solution": {
      "type": "int",
      "min": -6,
      "max": 6
    },
    "u": {
      "type": "int",
      "min": -3,
      "max": 2
    },
    "v": {
      "type": "int",
      "min": 1,
      "max": 5
    },
    "log_shift": {
      "type": "int",
      "min": -6,
      "max": 6
    },
    "log_power": {
      "type": "int",
      "min": 1,
      "max": 3
    },
    "center": {
      "type": "int",
      "min": -5,
      "max": 5
    }
  },
  "difficulty_overrides": {
    "1": {
      "mode": {
        "values": [
          "linear_direct",
          "exponential_same_base",
          "logarithmic_linear"
        ]
      },
      "a": {
        "max": 5
      },
      "threshold": {
        "min": -5,
        "max": 5
      },
      "solution": {
        "min": -4,
        "max": 4
      }
    },
    "2": {
      "mode": {
        "values": [
          "quadratic_between_roots",
          "trig_sine_interval",
          "irrational_root_bound"
        ]
      }
    },
    "3": {
      "mode": {
        "values": [
          "quadratic_outside_roots",
          "rational_sign_chart",
          "exponential_quadratic_substitution",
          "logarithmic_squared"
        ]
      }
    }
  },
  "modes": {
    "linear_direct": {
      "uses": [
        "a",
        "b",
        "threshold"
      ],
      "derived": {
        "rhs": "a*threshold+b"
      },
      "question": {
        "instruction": "Solve the inequality",
        "latex": "{a}x{b:+d}>{rhs}"
      }
    },
    "exponential_same_base": {
      "uses": [
        "base",
        "solution",
        "shift"
      ],
      "derived": {
        "target_power": "solution+shift"
      },
      "question": {
        "instruction": "Solve the exponential inequality",
        "latex": "{base}^{{x{shift:+d}}}>{base}^{{{target_power}}}"
      }
    },
    "logarithmic_linear": {
      "uses": [
        "base",
        "log_shift",
        "log_power"
      ],
      "derived": {
        "neg_shift": "-log_shift"
      },
      "question": {
        "instruction": "Solve the logarithmic inequality",
        "latex": "\\log_{{{base}}}(x{neg_shift:+d})>{log_power}"
      }
    },
    "quadratic_between_roots": {
      "uses": [
        "r1",
        "r2"
      ],
      "constraints": [
        "r1 < r2"
      ],
      "derived": {
        "bcoef": "-(r1+r2)",
        "ccoef": "r1*r2"
      },
      "question": {
        "instruction": "Solve the quadratic inequality",
        "latex": "x^2{bcoef:+d}x{ccoef:+d}<0"
      }
    },
    "trig_sine_interval": {
      "uses": [
        "alpha"
      ],
      "question": {
        "instruction": "Solve the trigonometric inequality on the given interval",
        "latex": "\\sin x\\ge\\sin {alpha}^\\circ,\\qquad 0^\\circ\\le x\\le180^\\circ"
      }
    },
    "irrational_root_bound": {
      "uses": [
        "p",
        "shift"
      ],
      "derived": {
        "threshold_value": "p**2-shift"
      },
      "question": {
        "instruction": "Solve the irrational inequality",
        "latex": "\\sqrt{{x+{shift}}}\\ge {p}"
      }
    },
    "quadratic_outside_roots": {
      "uses": [
        "r1",
        "r2"
      ],
      "constraints": [
        "r1 < r2"
      ],
      "derived": {
        "bcoef": "-(r1+r2)",
        "ccoef": "r1*r2"
      },
      "question": {
        "instruction": "Solve the quadratic inequality",
        "latex": "x^2{bcoef:+d}x{ccoef:+d}>0"
      }
    },
    "rational_sign_chart": {
      "uses": [
        "r1",
        "r2"
      ],
      "constraints": [
        "r1 < r2"
      ],
      "derived": {
        "neg_r1": "-r1",
        "neg_r2": "-r2"
      },
      "question": {
        "instruction": "Solve the rational inequality",
        "latex": "\\frac{{x{neg_r1:+d}}}{{x{neg_r2:+d}}}>0"
      }
    },
    "exponential_quadratic_substitution": {
      "uses": [
        "base",
        "u",
        "v"
      ],
      "constraints": [
        "u < v"
      ],
      "derived": {
        "sum_t": "base**u+base**v",
        "product_t": "base**(u+v)"
      },
      "question": {
        "instruction": "Solve the exponential inequality using a substitution",
        "latex": "{base}^{{2x}}-{sum_t}\\cdot {base}^x+{product_t}<0"
      }
    },
    "logarithmic_squared": {
      "uses": [
        "base",
        "center",
        "log_power"
      ],
      "derived": {
        "rhs_power": "2*log_power",
        "neg_center": "-center"
      },
      "question": {
        "instruction": "Solve the logarithmic inequality",
        "latex": "\\log_{{{base}}}\\left((x{neg_center:+d})^2\\right)\\ge {rhs_power}"
      }
    }
  },
  "answer": {
    "type": "symbolic_by_mode",
    "expression": {
      "linear_direct": "Interval.open(threshold,oo)",
      "exponential_same_base": "Interval.open(solution,oo)",
      "logarithmic_linear": "Interval.open(log_shift+base**log_power,oo)",
      "quadratic_between_roots": "Interval.open(r1,r2)",
      "trig_sine_interval": "Interval(alpha,180-alpha)",
      "irrational_root_bound": "Interval(p**2-shift,oo)",
      "quadratic_outside_roots": "Union(Interval.open(-oo,r1),Interval.open(r2,oo))",
      "rational_sign_chart": "Union(Interval.open(-oo,r1),Interval.open(r2,oo))",
      "exponential_quadratic_substitution": "Interval.open(u,v)",
      "logarithmic_squared": "Union(Interval(-oo,center-base**log_power),Interval(center+base**log_power,oo))"
    }
  },
  "answer_render": {
    "linear_direct": "interval",
    "exponential_same_base": "interval",
    "logarithmic_linear": "interval",
    "quadratic_between_roots": "interval",
    "trig_sine_interval": "degree_interval",
    "irrational_root_bound": "interval",
    "quadratic_outside_roots": "interval_union",
    "rational_sign_chart": "interval_union",
    "exponential_quadratic_substitution": "interval",
    "logarithmic_squared": "interval_union"
  },
