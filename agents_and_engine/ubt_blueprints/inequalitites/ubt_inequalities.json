  "validation": {
    "choice_count": 5,
    "distractor_pool_min": 6,
    "single_correct_answer": true,
    "unique_choices": true,
    "symbolic_equivalence": true,
    "set_equivalence": true,
    "interval_equivalence": true,
    "respect_open_closed_boundaries": true,
    "respect_rational_domain": true,
    "respect_radical_domain": true,
    "respect_log_domain": true,
    "trigonometric_interval_check": true,
    "reject_undefined_choices": true,
