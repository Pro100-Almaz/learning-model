        ]
      }
    }
  },
  "modes": {
    "linear_interval_system": {
      "uses": [
        "lower",
        "upper",
        "a",
        "b"
      ],
      "constraints": [
        "lower < upper"
      ],
      "derived": {
        "rhs": "a*upper+b"
      },
      "question": {
        "instruction": "Solve the system of inequalities",
        "latex": "\\begin{{cases}} x>{lower} \\\\ {a}x{b:+d}\\le {rhs} \\end{{cases}}"
      }
    },
    "linear_quadratic_system": {
      "uses": [
        "r1",
        "r2"
      ],
      "constraints": [
        "r1 < r2"
      ],
      "derived": {
        "bcoef": "-(r1+r2)",
        "ccoef": "r1*r2"
      },
      "question": {
        "instruction": "Solve the system of inequalities",
        "latex": "\\begin{{cases}} x>{r1} \\\\ x^2{bcoef:+d}x{ccoef:+d}\\le0 \\end{{cases}}"
      }
    },
    "quadratic_system": {
      "uses": [
        "r1",
        "r2"
      ],
      "constraints": [
        "r2-r1 >= 3"
      ],
      "derived": {
        "s1": "r1+1",
        "s2": "r2+1",
        "bcoef1": "-(r1+r2)",
        "ccoef1": "r1*r2",
        "bcoef2": "-((r1+1)+(r2+1))",
        "ccoef2": "(r1+1)*(r2+1)"
      },
      "question": {
        "instruction": "Solve the system of quadratic inequalities",
        "latex": "\\begin{{cases}} x^2{bcoef1:+d}x{ccoef1:+d}<0 \\\\ x^2{bcoef2:+d}x{ccoef2:+d}<0 \\end{{cases}}"
      }
    },
    "quadratic_union": {
      "uses": [
        "r1",
        "r2",
        "width"
      ],
      "constraints": [
        "r1 < r2"
      ],
      "derived": {
        "s1": "r2+1",
        "s2": "r2+1+width",
        "bcoef1": "-(r1+r2)",
        "ccoef1": "r1*r2",
        "bcoef2": "-((r2+1)+(r2+1+width))",
        "ccoef2": "(r2+1)*(r2+1+width)"
      },
      "question": {
        "instruction": "Find the union of the solution sets",
        "latex": "\\left[x^2{bcoef1:+d}x{ccoef1:+d}<0\\right]\\ \\cup\\ \\left[x^2{bcoef2:+d}x{ccoef2:+d}<0\\right]"
      }
    },
    "exponential_system": {
      "uses": [
        "base",
        "m",
        "n"
      ],
      "constraints": [
        "m < n"
      ],
      "question": {
        "instruction": "Solve the system of exponential inequalities",
        "latex": "\\begin{{cases}} {base}^x>{base}^{{{m}}} \\\\ {base}^x\\le {base}^{{{n}}} \\end{{cases}}"
      }
    },
    "logarithmic_system": {
      "uses": [
        "base",
        "m",
        "n",
        "lower"
      ],
      "constraints": [
        "m < n"
      ],
      "derived": {
        "neg_lower": "-lower"
      },
      "question": {
        "instruction": "Solve the system of logarithmic inequalities",
        "latex": "\\begin{{cases}} \\log_{{{base}}}(x{neg_lower:+d})>{m} \\\\ \\log_{{{base}}}(x{neg_lower:+d})\\le {n} \\end{{cases}}"
      }
    },
    "rational_system": {
      "uses": [
        "r1",
        "r2",
        "width"
      ],
      "constraints": [
        "r1 < r2"
      ],
      "derived": {
        "upper_bound": "r2+width",
        "neg_r1": "-r1",
        "neg_r2": "-r2"
      },
      "question": {
        "instruction": "Solve the system of inequalities",
        "latex": "\\begin{{cases}} \\frac{{x{neg_r1:+d}}}{{x{neg_r2:+d}}}>0 \\\\ x<{upper_bound} \\end{{cases}}"
      }
    },
    "exponential_substitution_system": {
      "uses": [
        "base",
        "m",
        "n"
      ],
      "constraints": [
        "m < n"
      ],
      "derived": {
        "sum_t": "base**m+base**n",
        "product_t": "base**(m+n)"
      },
      "question": {
        "instruction": "Solve the system using the substitution t=a^x",
        "latex": "\\begin{{cases}} {base}^{{2x}}-{sum_t}\\cdot {base}^x+{product_t}\\le0 \\\\ {base}^x>{base}^{{{m}}} \\end{{cases}}"
      }
    },
    "logarithmic_domain_system": {
      "uses": [
        "base",
        "m",
        "n",
        "lower",
        "upper"
      ],
      "constraints": [
        "m < n",
        "lower < upper"
      ],
      "derived": {
        "left_shift": "lower-base**m",
        "right_shift": "upper+base**n",
        "neg_left_shift": "-(lower-base**m)",
        "neg_right_shift": "-(upper+base**n)"
      },
      "question": {
        "instruction": "Solve the system of logarithmic inequalities",
        "latex": "\\begin{{cases}} \\log_{{{base}}}(x{neg_left_shift:+d})>{m} \\\\ \\log_{{{base}}}({right_shift}-x)>{n} \\end{{cases}}"
      }
    },
    "nonlinear_two_variable_membership": {
      "uses": [
        "x0",
        "y0"
      ],
      "constraints": [
        "x0 != y0"
      ],
      "derived": {
        "radius_sq": "x0**2+y0**2",
        "sum_xy": "x0+y0"
      },
      "question": {
        "instruction": "Which ordered pair satisfies the system?",
        "latex": "\\begin{{cases}} x^2+y^2\\le {radius_sq} \\\\ x+y\\ge {sum_xy} \\end{{cases}}"
      }
    }
  },
  "answer": {
    "type": "symbolic_by_mode",
    "expression": {
      "linear_interval_system": "Intersection(Interval.open(lower,oo),Interval(-oo,upper))",
      "linear_quadratic_system": "Intersection(Interval.open(r1,oo),Interval(r1,r2))",
      "quadratic_system": "Interval.open(r1+1,r2)",
      "quadratic_union": "Union(Interval.open(r1,r2),Interval.open(r2+1,r2+1+width))",
      "exponential_system": "Intersection(Interval.open(m,oo),Interval(-oo,n))",
      "logarithmic_system": "Intersection(Interval.open(lower+base**m,oo),Interval(-oo,lower+base**n))",
      "rational_system": "Union(Interval.open(-oo,r1),Interval.open(r2,r2+width))",
      "exponential_substitution_system": "Intersection(Interval.open(m,oo),Interval(m,n))",
      "logarithmic_domain_system": "Interval.open(lower,upper)",
      "nonlinear_two_variable_membership": "Tuple(x0,y0)"
    }
  },
