        "neg_r": "-(x0-base**m)",
        "neg_s2": "-(x0-base**n)",
        "rhs": "m+n",
        "other_root": "x0-base**m-base**n"
      },
      "question": {
        "instruction": "Solve the logarithmic equation",
        "latex": "\\log_{{{base}}}\\left((x{neg_r:+d})(x{neg_s2:+d})\\right)={rhs}"
      }
    }
