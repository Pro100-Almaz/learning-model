      "uses": [
        "base",
        "power",
        "solution",
        "coef"
      ],
      "derived": {
        "rhs_power": "base**power",
        "constant": "base**power-coef*solution"
      },
      "question": {
        "instruction": "Solve the logarithmic equation",
        "latex": "\\log_{{{base}}}\\left({coef}x{constant:+d}\\right)={power}"
      }
    },
    "exponential_common_factor": {
      "uses": [
        "base",
        "solution",
        "coef"
      ],
      "derived": {
        "rhs": "(base+coef)*base**solution"
      },
      "question": {
        "instruction": "Solve the exponential equation",
        "latex": "{base}^{{x+1}}+{coef}\\cdot {base}^x={rhs}"
      }
    },
    "exponential_quadratic_substitution": {
      "uses": [
        "base",
        "u",
        "v"
      ],
      "constraints": [
        "u != v",
        "u >= 0",
        "v >= 0"
      ],
      "derived": {
        "tu": "base**u",
        "tv": "base**v",
        "sum_t": "base**u+base**v",
        "product_t": "base**(u+v)"
      },
      "question": {
        "instruction": "Solve the equation using a substitution",
        "latex": "{base}^{{2x}}-{sum_t}\\cdot {base}^x+{product_t}=0"
      }
    },
    "log_sum_linear_factors": {
      "uses": [
        "base",
        "m",
        "n",
        "x0"
      ],
      "derived": {
        "r": "x0-base**m",
        "s2": "x0-base**n",
        "neg_r": "-(x0-base**m)",
        "neg_s2": "-(x0-base**n)",
        "rhs": "m+n"
      },
      "question": {
        "instruction": "Solve the logarithmic equation",
        "latex": "\\log_{{{base}}}(x{neg_r:+d})+\\log_{{{base}}}(x{neg_s2:+d})={rhs}"
      }
    },
    "exponential_reciprocal": {
      "uses": [
        "base",
        "power"
      ],
      "derived": {
        "rhs": "base**power+base**(-power)"
      },
      "question": {
        "instruction": "Solve the exponential equation",
        "latex": "{base}^x+{base}^{{-x}}={rhs_latex}"
      },
      "render_derived": {
        "rhs_latex": "latex(base**power+base**(-power))"
      }
    },
    "log_difference_linear_factors": {
      "uses": [
        "base",
        "power",
        "x0",
        "s"
      ],
      "constraints": [
        "x0 > s"
      ],
      "derived": {
        "B": "base**power",
        "r": "base**power*s-(base**power-1)*x0",
        "neg_r": "-(base**power*s-(base**power-1)*x0)",
        "neg_s": "-s"
      },
      "question": {
        "instruction": "Solve the logarithmic equation",
        "latex": "\\log_{{{base}}}(x{neg_r:+d})-\\log_{{{base}}}(x{neg_s:+d})={power}"
      }
    },
    "log_quadratic_argument": {
      "uses": [
