  "modes": {
    "simple_sine_equation": {
      "uses": [
        "alpha"
      ],
      "question": {
        "instruction": "Solve the equation on the given interval",
        "latex": "\\sin x=\\sin {alpha}^\\circ,\\qquad 0^\\circ\\le x<360^\\circ"
      }
    },
    "simple_cosine_equation": {
      "uses": [
        "alpha"
      ],
      "question": {
        "instruction": "Solve the equation on the given interval",
        "latex": "\\cos x=\\cos {alpha}^\\circ,\\qquad 0^\\circ\\le x<360^\\circ"
      }
    },
    "inverse_trig_equation": {
      "uses": [
        "inverse_angle"
      ],
      "question": {
        "instruction": "Solve for x",
        "latex": "\\arcsin x={inverse_angle}^\\circ"
      }
    },
    "irrational_nth_power": {
      "uses": [
        "degree",
        "a",
        "root_value",
        "irr_solution"
      ],
      "derived": {
        "b": "root_value**degree-a*irr_solution"
      },
      "question": {
        "instruction": "Solve the irrational equation",
        "latex": "\\sqrt[{degree}]{{{a}x{b:+d}}}={root_value}"
      }
    },
    "trig_quadratic_sine": {
      "uses": [
        "alpha"
      ],
      "question": {
        "instruction": "Solve the equation on the given interval",
        "latex": "\\sin^2 x=\\sin^2 {alpha}^\\circ,\\qquad 0^\\circ\\le x<360^\\circ"
      }
    },
    "trig_sum_to_product_count": {
      "uses": [
        "k"
      ],
      "derived": {
        "two_k": "2*k"
      },
      "question": {
        "instruction": "Find the number of roots on the interval",
        "latex": "\\sin({k}x)+\\sin({two_k}x)=0,\\qquad 0\\le x<2\\pi"
      }
    },
    "irrational_substitution": {
      "uses": [
        "p",
        "q"
      ],
      "constraints": [
        "p != q"
      ],
      "derived": {
        "pq": "p*q",
        "sum_pq": "p+q"
      },
      "question": {
        "instruction": "Solve the equation using a substitution",
        "latex": "\\sqrt{x}+\\frac{{{pq}}}{{\\sqrt{x}}}={sum_pq},\\qquad x>0"
      }
    },
    "trig_homogeneous": {
      "uses": [
        "t1",
        "t2"
      ],
      "constraints": [
        "t1 != t2"
      ],
      "derived": {
        "middle": "-(t1+t2)",
        "constant": "t1*t2"
      },
      "question": {
        "instruction": "Reduce the homogeneous trigonometric equation and find all possible values of tan x",
        "latex": "\\sin^2x{middle:+d}\\sin x\\cos x{constant:+d}\\cos^2x=0"
      }
    },
    "trig_auxiliary_angle": {
      "uses": [
        "scale"
      ],
      "question": {
        "instruction": "Solve the equation on the given interval using an auxiliary angle",
        "latex": "{scale}\\sin x+{scale}\\cos x={scale},\\qquad 0^\\circ\\le x<360^\\circ"
      }
    },
    "irrational_two_radicals": {
      "uses": [
        "s",
        "t"
      ],
      "constraints": [
        "t > s"
      ],
      "derived": {
        "d": "t**2-s**2",
        "rhs": "s+t"
      },
      "question": {
        "instruction": "Solve the irrational equation",
        "latex": "\\sqrt{x}+\\sqrt{{x+{d}}}={rhs}"
      }
    }
  },
