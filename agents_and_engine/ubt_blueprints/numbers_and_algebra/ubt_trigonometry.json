      "uses": [
        "a",
        "b"
      ],
      "symbols": [
        "x"
      ],
      "constraints": [
        "a != b"
      ],
      "question": {
        "instruction": "Transform the sum into a product",
        "latex": "\\sin({a}x)+\\sin({b}x)"
      }
    },
    "product_to_sum": {
