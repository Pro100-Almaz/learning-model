        "b"
      ],
      "symbols": [
        "x"
      ],
      "constraints": [
        "a != b"
      ],
      "question": {
        "instruction": "Transform the product into a sum",
        "latex": "2\\sin({a}x)\\cos({b}x)"
      }
    },
