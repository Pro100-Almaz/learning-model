  "modes": {
    "expand_square": {
      "uses": [
        "a",
        "b",
        "sign"
      ],
      "symbols": [
        "x"
      ],
      "constraints": [
        "a != b"
      ],
      "derived": {
        "signed_b": "sign*b"
      },
      "question": {
        "instruction": "Expand and simplify",
        "latex": "\\left({a}x{signed_b:+d}\\right)^2"
      }
    },
    "factor_difference_squares": {
      "uses": [
        "a",
        "b"
      ],
      "symbols": [
        "x"
      ],
      "constraints": [
        "a != b"
      ],
      "derived": {
        "a2": "a**2",
        "b2": "b**2"
      },
      "question": {
        "instruction": "Factor completely",
        "latex": "{a2}x^2-{b2}"
      }
    },
    "factor_common": {
      "uses": [
        "a",
        "b",
        "c"
      ],
      "symbols": [
        "x"
      ],
      "constraints": [
        "b != c"
      ],
      "question": {
        "instruction": "Factor completely",
        "latex": "{a*b}x^2+{a*c}x"
      }
    },
    "factor_sum_difference_cubes": {
      "uses": [
        "a",
        "b",
        "sign"
      ],
      "symbols": [
        "x"
      ],
      "derived": {
        "a3": "a**3",
        "b3": "b**3",
        "op": "'+' if sign == 1 else '-'"
      },
      "question": {
        "instruction": "Factor completely",
        "latex": "{a3}x^3{op}{b3}"
      }
    },
    "factor_grouping": {
      "uses": [
        "a",
        "b",
        "c"
      ],
      "symbols": [
        "x"
      ],
      "constraints": [
        "a != b",
        "b != c",
        "a != c"
      ],
      "derived": {
        "ab": "a*b",
        "ac": "a*c",
        "bc": "b*c"
      },
      "question": {
        "instruction": "Factor completely",
        "latex": "{a}x^3+{b}x^2+{ac}x+{bc}"
      }
    },
    "simplify_rational_expression": {
      "uses": [
        "r",
        "s"
      ],
      "symbols": [
        "x"
      ],
      "constraints": [
        "r != s",
        "r != 0",
        "s != 0"
      ],
      "derived": {
        "sum_rs": "r+s",
        "product_rs": "r*s"
      },
      "question": {
        "instruction": "Simplify the expression, taking its domain restrictions into account",
        "latex": "\\frac{{x^2-{sum_rs}x+{product_rs}}}{{x-{r}}}"
      }
    },
    "excluded_value": {
      "uses": [
        "r",
        "s"
      ],
      "symbols": [
        "x"
      ],
      "constraints": [
        "r != s"
      ],
      "derived": {
        "sum_rs": "r+s",
        "product_rs": "r*s"
      },
      "question": {
        "instruction": "Which value of x is excluded from the domain?",
        "latex": "\\frac{{x^2-{sum_rs}x+{product_rs}}}{{x-{r}}}"
      }
    },
    "polynomial_root": {
      "uses": [
        "r",
        "s",
        "a"
      ],
      "symbols": [
        "x"
      ],
      "constraints": [
        "r != s",
        "r != 0",
        "s != 0"
      ],
      "derived": {
        "sum_rs": "r+s",
        "product_rs": "r*s",
        "bcoef": "-a*(r+s)",
        "ccoef": "a*r*s"
      },
      "question": {
        "instruction": "Which of the following numbers is a root of the polynomial?",
        "latex": "{a}x^2{bcoef:+d}x{ccoef:+d}"
      }
    }
  },
  "constraints": [
    "a > 0",
    "b > 0",
    "c > 0"
  ],
  "answer": {
