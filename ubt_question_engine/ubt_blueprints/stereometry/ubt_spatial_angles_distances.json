    "inscribed_sphere_radius_cube": {
      "uses": [
        "edge"
      ],
      "comment": "The inscribed sphere touches the six faces, so its radius is half the edge; the circumscribed one passes through the vertices and is the distractor that matters.",
      "question": {
        "instruction": "A sphere is inscribed in a cube with the given edge. Find the radius of the sphere.",
        "latex": "a={edge}"
      }
    },
    "square_pyramid_lateral_edge": {
      "uses": [
        "a",
        "height"
      ],
      "comment": "The lateral edge reaches a vertex of the base, so the horizontal leg is half the base diagonal, a*sqrt(2)/2 -- not half the base side, which is the slant-height leg.",
      "question": {
        "instruction": "A regular pyramid has a square base with the given side and the given height. Find the length of a lateral edge.",
        "latex": "a={a},\\qquad h={height}"
      }
    },
    "cuboid_diagonal_angle_tangent": {
      "uses": [
        "a",
        "height"
      ],
      "comment": "The space diagonal projects onto the base diagonal, of length a*sqrt(2), so the tangent is h/(a*sqrt(2)).",
      "question": {
        "instruction": "A right prism has a square base with the given side and the given height. Find the tangent of the angle between its space diagonal and the base plane.",
        "latex": "a={a},\\qquad h={height}"
      }
    },
    "regular_tetrahedron_height": {
      "uses": [
        "edge"
      ],
      "question": {
        "instruction": "Find the height of the regular tetrahedron with the given edge.",
        "latex": "a={edge}"
      }
    },
    "circumscribed_sphere_radius_cuboid": {
      "uses": [
        "a",
        "b",
        "c"
      ],
      "comment": "The centre is the midpoint of the space diagonal, so the radius is half of it.",
      "constraints": [
        "a != b",
        "b != c",
        "a != c"
      ],
      "question": {
        "instruction": "A sphere passes through all vertices of the rectangular parallelepiped with the given edges. Find the radius of the sphere.",
        "latex": "a={a},\\qquad b={b},\\qquad c={c}"
      }
    }
