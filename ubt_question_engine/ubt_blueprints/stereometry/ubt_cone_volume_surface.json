  "parent_topic_number": 16,
  "display_name": "Stereometry — cones and cone frustums: volume and surface area",
  "curriculum_ref": "KZ 2026 UBT — Stereometry — Cones",
  "constraints_template": "ubt_question.j2",
  "_comment": "Replaces the trivia generator that asked how many circles appear in the net of a cone. The lateral-area modes derive the radius and height from a 3-4-5 triple so the slant height is an integer and the answer stays a clean multiple of pi. Python/SymPy owns generation, mathematics, validation and distractor filtering; Jinja only renders prepared question data.",
  "tag": {
    "name": "Стереометрия",
    "slug": "stereometriya"
  },
  "expression_language": "sympy",
  "parameters": {
    "mode": {
      "type": "choice",
      "values": [
        "cone_volume",
        "cone_axial_section_area",
        "cone_slant_height",
        "cone_lateral_area",
        "cone_total_surface_area",
        "cone_frustum_volume"
      ],
      "desc": "question structure"
    },
    "r": {
      "type": "int",
      "min": 2,
      "max": 10
    },
    "height": {
      "type": "int",
      "min": 2,
      "max": 12
    },
    "scale": {
      "type": "int",
      "min": 1,
      "max": 5,
      "desc": "multiplier on the 3-4-5 triple, so the slant height is an integer"
    },
    "radius_big": {
      "type": "int",
      "min": 3,
      "max": 12
    },
    "radius_small": {
      "type": "int",
      "min": 1,
      "max": 10
    }
  },
  "supported_difficulties": [
    1,
    2,
    3
  ],
  "default_difficulty": 1,
  "difficulty_overrides": {
    "1": {
      "mode": {
        "values": [
          "cone_volume",
          "cone_axial_section_area"
        ]
      }
    },
    "2": {
      "mode": {
        "values": [
          "cone_slant_height",
          "cone_lateral_area"
        ]
      }
    },
    "3": {
      "mode": {
        "values": [
          "cone_total_surface_area",
          "cone_frustum_volume"
        ]
      }
    }
  },
  "modes": {
    "cone_volume": {
      "uses": [
        "r",
        "height"
      ],
      "question": {
        "instruction": "Find the volume of the cone with the given base radius and height.",
        "latex": "r={r},\\qquad h={height}"
      }
    },
    "cone_axial_section_area": {
      "uses": [
        "r",
        "height"
      ],
      "comment": "The axial section is a triangle of base 2r and height h, so its area is r*h and carries no pi.",
      "question": {
        "instruction": "A plane through the axis of the cone cuts it in a triangle. Find the area of this axial section.",
        "latex": "r={r},\\qquad h={height}"
      }
    },
    "cone_slant_height": {
      "uses": [
        "r",
        "height"
      ],
      "question": {
        "instruction": "Find the slant height of the cone with the given base radius and height.",
        "latex": "r={r},\\qquad h={height}"
      }
    },
    "cone_lateral_area": {
      "uses": [
        "scale"
      ],
      "derived": {
        "cone_radius": "3*scale",
        "cone_height": "4*scale",
        "slant": "5*scale"
      },
      "question": {
        "instruction": "Find the lateral surface area of the cone with the given base radius and height.",
        "latex": "r={cone_radius},\\qquad h={cone_height}"
      }
    },
    "cone_total_surface_area": {
      "uses": [
        "scale"
      ],
      "derived": {
        "cone_radius": "3*scale",
        "cone_height": "4*scale",
        "slant": "5*scale"
      },
      "question": {
        "instruction": "Find the total surface area of the cone with the given base radius and height.",
        "latex": "r={cone_radius},\\qquad h={cone_height}"
      }
    },
    "cone_frustum_volume": {
      "uses": [
        "radius_big",
        "radius_small",
        "height"
      ],
      "comment": "Equal radii would make the frustum a cylinder and collapse the correct answer onto the cylinder-formula distractor.",
      "constraints": [
        "radius_big > radius_small"
      ],
      "question": {
        "instruction": "A frustum of a cone has the given base radii and height. Find its volume.",
        "latex": "R={radius_big},\\qquad r={radius_small},\\qquad h={height}"
      }
    }
  },
  "answer": {
    "type": "symbolic_by_mode",
    "expression": {
      "cone_volume": "pi*r**2*height/3",
      "cone_axial_section_area": "r*height",
      "cone_slant_height": "sqrt(r**2+height**2)",
      "cone_lateral_area": "pi*cone_radius*slant",
      "cone_total_surface_area": "pi*cone_radius*(cone_radius+slant)",
      "cone_frustum_volume": "pi*height*(radius_big**2+radius_small**2+radius_big*radius_small)/3"
    }
  },
  "answer_render": {
