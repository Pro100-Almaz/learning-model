  "modes": {
    "square_pyramid_volume": {
      "uses": [
        "a",
        "height"
      ],
      "question": {
        "instruction": "A pyramid has a square base with the given side and the given height. Find its volume.",
        "latex": "a={a},\\qquad h={height}"
      }
    },
    "pyramid_volume_from_base_area": {
      "uses": [
        "base_area",
        "height"
      ],
      "question": {
        "instruction": "A pyramid has the given base area and height. Find its volume.",
        "latex": "S_{{\\text{{base}}}}={base_area},\\qquad h={height}"
      }
    },
    "regular_pyramid_lateral_area": {
      "uses": [
        "n",
        "a",
        "apothem"
      ],
      "comment": "Apothem here is the slant height of a lateral face, which is what the lateral-area formula needs; the pyramid's own height is deliberately absent so the student cannot substitute it.",
      "question": {
        "instruction": "A regular pyramid has a base with n equal sides and the given slant height of a lateral face. Find its lateral surface area.",
        "latex": "n={n},\\qquad a={a},\\qquad m={apothem}"
      }
    },
    "square_pyramid_slant_height": {
      "uses": [
        "a",
        "height"
      ],
      "question": {
        "instruction": "A regular pyramid has a square base with the given side and the given height. Find the slant height of a lateral face.",
        "latex": "a={a},\\qquad h={height}"
      }
    },
    "regular_tetrahedron_volume": {
      "uses": [
        "edge"
      ],
      "question": {
        "instruction": "Find the volume of the regular tetrahedron with the given edge.",
        "latex": "a={edge}"
      }
    },
    "pyramid_frustum_volume": {
      "uses": [
        "a",
        "b",
        "height"
      ],
      "comment": "Equal bases would make the frustum a prism and collapse the correct answer onto the prism-formula distractor.",
      "constraints": [
        "a != b"
      ],
      "question": {
        "instruction": "A frustum of a pyramid has square bases with the given sides and the given height. Find its volume.",
        "latex": "a={a},\\qquad b={b},\\qquad h={height}"
      }
    }
  },
  "answer": {
    "type": "symbolic_by_mode",
    "expression": {
      "square_pyramid_volume": "a**2*height/3",
      "pyramid_volume_from_base_area": "base_area*height/3",
      "regular_pyramid_lateral_area": "n*a*apothem/2",
      "square_pyramid_slant_height": "sqrt(height**2+(a/2)**2)",
      "regular_tetrahedron_volume": "edge**3*sqrt(2)/12",
      "pyramid_frustum_volume": "height*(a**2+b**2+a*b)/3"
    }
  },
