        ]
      }
    },
    "3": {
      "mode": {
        "values": [
          "sphere_section_area",
          "sphere_volume_from_diameter"
        ]
      }
    }
  },
  "modes": {
    "sphere_surface_area": {
      "uses": [
        "radius"
      ],
      "question": {
        "instruction": "Find the surface area of the sphere with the given radius.",
        "latex": "R={radius}"
      }
    },
    "sphere_volume": {
      "uses": [
        "radius"
      ],
      "question": {
        "instruction": "Find the volume of the ball with the given radius.",
        "latex": "R={radius}"
      }
    },
    "sphere_section_radius": {
      "uses": [
        "scale"
      ],
      "derived": {
        "sphere_radius": "5*scale",
        "plane_distance": "3*scale"
      },
      "question": {
        "instruction": "A plane at the given distance from the centre of a sphere cuts it in a circle. Find the radius of that circle.",
        "latex": "R={sphere_radius},\\qquad d={plane_distance}"
      }
    },
    "hemisphere_total_surface_area": {
      "uses": [
        "radius"
      ],
      "comment": "Total, not curved: the flat disc counts, and forgetting it is the mistake the pool is built around.",
      "question": {
        "instruction": "Find the total surface area of the hemisphere with the given radius, including its flat circular face.",
        "latex": "R={radius}"
      }
    },
    "sphere_section_area": {
      "uses": [
        "scale"
      ],
      "derived": {
        "sphere_radius": "5*scale",
        "plane_distance": "3*scale"
      },
      "question": {
        "instruction": "A plane at the given distance from the centre of a sphere cuts it in a circle. Find the area of that circle.",
        "latex": "R={sphere_radius},\\qquad d={plane_distance}"
      }
    },
    "sphere_volume_from_diameter": {
      "uses": [
        "diameter"
      ],
      "question": {
        "instruction": "Find the volume of the ball with the given diameter.",
        "latex": "d={diameter}"
      }
    }
  },
  "answer": {
    "type": "symbolic_by_mode",
    "expression": {
      "sphere_surface_area": "4*pi*radius**2",
      "sphere_volume": "4*pi*radius**3/3",
      "sphere_section_radius": "sqrt(sphere_radius**2-plane_distance**2)",
      "hemisphere_total_surface_area": "3*pi*radius**2",
      "sphere_section_area": "pi*(sphere_radius**2-plane_distance**2)",
      "sphere_volume_from_diameter": "4*pi*(diameter/2)**3/3"
    }
  },
