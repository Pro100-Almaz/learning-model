  "display_name": "Stereometry — spheres: volume, surface area and plane sections",
  "curriculum_ref": "KZ 2026 UBT — Stereometry — Spheres",
  "constraints_template": "ubt_question.j2",
  "_comment": "Replaces the classification generator that asked whether a plane meets a sphere in a point, a circle or nothing. The section modes derive the radius and the plane distance from a 3-4-5 triple, so the section radius is an integer rather than an unusable surd. Python/SymPy owns generation, mathematics, validation and distractor filtering; Jinja only renders prepared question data.",
  "tag": {
    "name": "Стереометрия",
    "slug": "stereometriya"
  },
  "expression_language": "sympy",
  "parameters": {
    "mode": {
      "type": "choice",
      "values": [
        "sphere_surface_area",
        "sphere_volume",
        "sphere_section_radius",
        "hemisphere_total_surface_area",
        "sphere_section_area",
        "sphere_volume_from_diameter"
      ],
      "desc": "question structure"
    },
    "radius": {
      "type": "int",
      "min": 2,
      "max": 10
    },
    "scale": {
      "type": "int",
      "min": 1,
      "max": 4,
      "desc": "multiplier on the 3-4-5 triple, so the section radius is an integer"
    },
    "diameter": {
      "type": "choice",
      "values": [
        4,
        6,
        8,
        10,
        12,
        14
      ],
      "desc": "even, so the radius stays an integer"
    }
  },
  "supported_difficulties": [
    1,
    2,
    3
  ],
  "default_difficulty": 1,
  "difficulty_overrides": {
