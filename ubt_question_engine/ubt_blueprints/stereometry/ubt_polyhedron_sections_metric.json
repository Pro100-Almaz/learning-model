    "cuboid_diagonal_section_area": "exact_expression",
    "cube_diagonal_section_area": "exact_expression",
    "pyramid_section_parallel_to_base": "scalar",
    "cone_section_parallel_to_base": "exact_expression",
    "cylinder_section_parallel_to_axis": "scalar"
  },
