        ]
      }
    }
  },
  "modes": {
    "triangular_prism_section_parallel_to_base": {
      "uses": [
        "a"
      ],
      "comment": "A section parallel to the base of a PRISM is congruent to the base -- no scaling at all. The pyramid and cone modes then contrast with it.",
      "question": {
        "instruction": "A plane parallel to the base cuts a regular triangular prism whose base edge is given. The section is a triangle. Find its area.",
        "latex": "a={a}"
      }
    },
    "cuboid_diagonal_section_area": {
      "uses": [
        "a",
        "b",
        "c"
      ],
      "comment": "The section through two opposite lateral edges is a rectangle: the base diagonal by the height.",
      "constraints": [
        "a != b"
      ],
      "question": {
        "instruction": "A plane through two opposite lateral edges cuts a rectangular parallelepiped in a rectangle. Find the area of that section.",
        "latex": "a={a},\\qquad b={b},\\qquad h={c}"
      }
    },
    "cube_diagonal_section_area": {
      "uses": [
        "edge"
      ],
      "question": {
        "instruction": "A plane through two opposite lateral edges cuts a cube in a rectangle. Find the area of that section.",
        "latex": "a={edge}"
      }
    },
    "pyramid_section_parallel_to_base": {
      "uses": [
        "base_area",
        "ratio_m",
        "ratio_n"
      ],
      "comment": "The plane is at m/n of the way down from the apex, so lengths scale by m/n and areas by the square of it. Of the six pairs with m<n in these ranges only (2,4) is reducible, and it is the only one summing to 6 -- cheaper than a gcd the expression language does not expose.",
      "constraints": [
        "ratio_m < ratio_n",
        "ratio_m + ratio_n != 6"
      ],
      "question": {
        "instruction": "A plane parallel to the base cuts a pyramid at the given fraction of its height, measured from the apex. The base area is given. Find the area of the section.",
        "latex": "S_{{\\text{{base}}}}={base_area},\\qquad \\frac{{m}}{{n}}=\\frac{{{ratio_m}}}{{{ratio_n}}}"
      }
    },
    "cone_section_parallel_to_base": {
      "uses": [
        "r",
        "ratio_m",
        "ratio_n"
      ],
      "comment": "Same reducibility guard as the pyramid mode above.",
      "constraints": [
        "ratio_m < ratio_n",
        "ratio_m + ratio_n != 6"
      ],
      "question": {
        "instruction": "A plane parallel to the base cuts a cone at the given fraction of its height, measured from the apex. The base radius is given. Find the area of the section.",
        "latex": "R={r},\\qquad \\frac{{m}}{{n}}=\\frac{{{ratio_m}}}{{{ratio_n}}}"
      }
    },
    "cylinder_section_parallel_to_axis": {
      "uses": [
        "scale",
        "height"
      ],
      "comment": "The section is a rectangle: the chord cut by the plane, times the height. The chord is 2*sqrt(R^2-d^2), made an integer by the 3-4-5 triple.",
      "derived": {
        "cylinder_radius": "5*scale",
        "axis_distance": "3*scale",
        "half_chord": "4*scale"
      },
      "question": {
        "instruction": "A plane parallel to the axis of a cylinder, at the given distance from it, cuts the cylinder in a rectangle. Find the area of that section.",
        "latex": "R={cylinder_radius},\\qquad d={axis_distance},\\qquad h={height}"
      }
    }
  },
  "answer": {
    "type": "symbolic_by_mode",
    "expression": {
      "triangular_prism_section_parallel_to_base": "sqrt(3)*a**2/4",
      "cuboid_diagonal_section_area": "c*sqrt(a**2+b**2)",
      "cube_diagonal_section_area": "edge**2*sqrt(2)",
      "pyramid_section_parallel_to_base": "base_area*ratio_m**2/ratio_n**2",
      "cone_section_parallel_to_base": "pi*r**2*ratio_m**2/ratio_n**2",
      "cylinder_section_parallel_to_axis": "2*half_chord*height"
    }
  },
