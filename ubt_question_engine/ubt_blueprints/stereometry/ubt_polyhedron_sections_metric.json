  "display_name": "Stereometry — areas of plane sections of solids",
  "curriculum_ref": "KZ 2026 UBT — Stereometry — Sections of solids",
  "constraints_template": "ubt_question.j2",
  "_comment": "Replaces the generator that asked what SHAPE a section is -- a question whose answer is given away by any diagram of the solid. Here the shape is stated and the area is computed. The similarity modes are the point of the family: a section parallel to the base of a cone or pyramid scales areas by k squared, and answering with k instead is the classic error. Python/SymPy owns generation, mathematics, validation and distractor filtering; Jinja only renders prepared question data.",
  "tag": {
    "name": "Стереометрия",
    "slug": "stereometriya"
  },
  "expression_language": "sympy",
  "parameters": {
    "mode": {
      "type": "choice",
      "values": [
        "triangular_prism_section_parallel_to_base",
        "cuboid_diagonal_section_area",
        "cube_diagonal_section_area",
        "pyramid_section_parallel_to_base",
        "cone_section_parallel_to_base",
        "cylinder_section_parallel_to_axis"
      ],
      "desc": "question structure"
    },
    "a": {
      "type": "int",
      "min": 2,
      "max": 12
    },
    "b": {
      "type": "int",
      "min": 2,
      "max": 12
    },
    "c": {
      "type": "int",
      "min": 2,
      "max": 12
    },
    "edge": {
      "type": "int",
      "min": 2,
      "max": 10
    },
    "r": {
      "type": "int",
      "min": 2,
      "max": 10
    },
    "height": {
      "type": "int",
      "min": 2,
      "max": 12
    },
    "base_area": {
      "type": "choice",
      "values": [
        12,
        16,
        24,
        36,
        48,
        64,
        72,
        100
      ]
    },
    "ratio_m": {
      "type": "int",
      "min": 1,
      "max": 3,
      "desc": "numerator of the similarity ratio, measured from the apex"
    },
    "ratio_n": {
      "type": "int",
      "min": 2,
      "max": 4,
      "desc": "denominator of the similarity ratio"
    },
    "scale": {
      "type": "int",
      "min": 1,
      "max": 4,
      "desc": "multiplier on the 3-4-5 triple, so the half-chord is an integer"
    }
  },
  "supported_difficulties": [
    1,
    2,
    3
  ],
  "default_difficulty": 1,
  "difficulty_overrides": {
    "1": {
      "mode": {
        "values": [
          "triangular_prism_section_parallel_to_base",
          "cuboid_diagonal_section_area"
        ]
      }
    },
    "2": {
      "mode": {
        "values": [
