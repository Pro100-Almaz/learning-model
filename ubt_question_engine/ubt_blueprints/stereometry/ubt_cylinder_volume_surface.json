  "parent_topic_number": 16,
  "display_name": "Stereometry — cylinders: volume and surface area",
  "curriculum_ref": "KZ 2026 UBT — Stereometry — Cylinders",
  "constraints_template": "ubt_question.j2",
  "_comment": "Replaces the trivia generator that asked how many bases a cylinder has. Answers stay exact multiples of pi -- never a decimal approximation -- so symbolic equivalence can decide correctness. Python/SymPy owns generation, mathematics, validation and distractor filtering; Jinja only renders prepared question data.",
  "tag": {
    "name": "Стереометрия",
    "slug": "stereometriya"
  },
  "expression_language": "sympy",
  "parameters": {
    "mode": {
      "type": "choice",
      "values": [
        "cylinder_volume",
        "cylinder_lateral_area",
        "cylinder_total_surface_area",
        "cylinder_axial_section_area",
        "cylinder_volume_from_diameter",
        "cylinder_height_from_volume"
      ],
      "desc": "question structure"
    },
    "r": {
      "type": "int",
      "min": 2,
      "max": 10
    },
    "height": {
      "type": "int",
      "min": 2,
      "max": 12
    },
    "diameter": {
      "type": "choice",
      "values": [
        4,
        6,
        8,
        10,
        12,
        14,
        16
      ],
      "desc": "even, so the radius stays an integer"
    }
  },
  "supported_difficulties": [
    1,
    2,
    3
  ],
  "default_difficulty": 1,
  "difficulty_overrides": {
    "1": {
      "mode": {
        "values": [
          "cylinder_volume",
          "cylinder_lateral_area"
        ]
      }
    },
    "2": {
      "mode": {
        "values": [
          "cylinder_total_surface_area",
          "cylinder_axial_section_area"
        ]
      }
    },
    "3": {
      "mode": {
        "values": [
          "cylinder_volume_from_diameter",
          "cylinder_height_from_volume"
        ]
      }
    }
  },
  "modes": {
    "cylinder_volume": {
      "uses": [
        "r",
        "height"
      ],
      "question": {
        "instruction": "Find the volume of the cylinder with the given radius and height.",
        "latex": "r={r},\\qquad h={height}"
      }
    },
    "cylinder_lateral_area": {
      "uses": [
        "r",
        "height"
      ],
      "question": {
        "instruction": "Find the lateral surface area of the cylinder with the given radius and height.",
        "latex": "r={r},\\qquad h={height}"
      }
    },
    "cylinder_total_surface_area": {
      "uses": [
        "r",
        "height"
      ],
      "question": {
        "instruction": "Find the total surface area of the cylinder with the given radius and height.",
        "latex": "r={r},\\qquad h={height}"
      }
    },
    "cylinder_axial_section_area": {
      "uses": [
        "r",
        "height"
      ],
      "comment": "The axial section is a rectangle 2r by h, so the answer carries no pi at all. That is the point of the mode: a student who reaches for pi has not pictured the section.",
      "question": {
        "instruction": "A plane through the axis of the cylinder cuts it in a rectangle. Find the area of this axial section.",
        "latex": "r={r},\\qquad h={height}"
      }
    },
    "cylinder_volume_from_diameter": {
      "uses": [
        "diameter",
        "height"
      ],
      "question": {
        "instruction": "Find the volume of the cylinder with the given base diameter and height.",
        "latex": "d={diameter},\\qquad h={height}"
      }
    },
    "cylinder_height_from_volume": {
      "uses": [
        "r",
        "height"
      ],
      "comment": "The height is rolled and the volume derived from it, so the answer is always an exact integer rather than a fraction the student cannot check.",
      "derived": {
        "volume_coefficient": "r**2*height"
      },
      "question": {
        "instruction": "The volume and the base radius of a cylinder are given. Find its height.",
        "latex": "V={volume_coefficient}\\pi,\\qquad r={r}"
      }
    }
  },
  "answer": {
    "type": "symbolic_by_mode",
    "expression": {
      "cylinder_volume": "pi*r**2*height",
      "cylinder_lateral_area": "2*pi*r*height",
      "cylinder_total_surface_area": "2*pi*r*(r+height)",
      "cylinder_axial_section_area": "2*r*height",
      "cylinder_volume_from_diameter": "pi*(diameter/2)**2*height",
      "cylinder_height_from_volume": "height"
    }
  },
  "answer_render": {
    "cylinder_volume": "exact_expression",
    "cylinder_lateral_area": "exact_expression",
    "cylinder_total_surface_area": "exact_expression",
    "cylinder_axial_section_area": "scalar",
    "cylinder_volume_from_diameter": "exact_expression",
    "cylinder_height_from_volume": "scalar"
  },
