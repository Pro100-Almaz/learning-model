{
  "topic": "ubt_powers",
  "display_name": "Powers and scientific notation",
  "curriculum_ref": "KZ 2026 UBT — Numbers — Topic 02",
  "constraints_template": "ubt_question.j2",
  "_comment": "Deterministic topic config. Difficulty is controlled primarily by mathematical structure (mode), not by larger numbers. Python evaluates all expressions and validates choices; Jinja only renders prepared question data.",
  "tag": {
    "name": "Дәрежелер",
    "slug": "darezheler"
  },
  "default_difficulty": 1,
  "expression_language": "sympy",
  "parameters": {
    "mode": {
      "type": "choice",
      "values": [
        "evaluate_integer_power",
        "multiply_same_base",
        "divide_same_base",
        "power_of_power",
        "simplify_monomial_powers",
        "find_missing_exponent",
        "scientific_multiply",
        "scientific_divide",
        "unit_conversion_scientific"
      ],
      "desc": "question structure"
    },
    "base": {
      "type": "int",
      "min": 2,
      "max": 9
    },
    "exp1": {
      "type": "int",
      "min": 2,
      "max": 7
    },
    "exp2": {
      "type": "int",
      "min": 1,
      "max": 6
    },
    "outer_exp": {
      "type": "int",
      "min": 2,
      "max": 4
    },
    "coef1": {
      "type": "int",
      "min": 1,
      "max": 9
    },
    "coef2": {
      "type": "int",
      "min": 1,
      "max": 9
    },
    "ten_exp1": {
      "type": "int",
      "min": -6,
      "max": 6
    },
    "ten_exp2": {
      "type": "int",
      "min": -6,
      "max": 6
    },
    "unit_power": {
      "type": "choice",
      "values": [
        3,
        6,
        9
      ]
    }
  },
  "difficulty_overrides": {
    "1": {
      "mode": {
        "values": [
          "evaluate_integer_power",
          "multiply_same_base",
          "divide_same_base",
          "power_of_power"
        ]
      },
      "base": {
        "max": 7
      },
      "exp1": {
        "max": 5
      },
      "exp2": {
        "max": 4
      }
    },
    "2": {
      "mode": {
        "values": [
          "simplify_monomial_powers",
          "find_missing_exponent",
          "scientific_multiply",
          "scientific_divide"
        ]
      }
    },
    "3": {
      "mode": {
        "values": [
          "simplify_monomial_powers",
          "find_missing_exponent",
          "scientific_multiply",
          "scientific_divide",
          "unit_conversion_scientific"
        ]
      },
      "exp1": {
        "max": 7
      },
      "exp2": {
        "max": 6
      },
      "ten_exp1": {
        "min": -6,
        "max": 6
      },
      "ten_exp2": {
        "min": -6,
        "max": 6
      }
    }
  },
  "modes": {
    "evaluate_integer_power": {
      "uses": [
        "base",
        "exp1"
      ],
      "question": {
        "instruction": "Evaluate",
        "latex": "{base}^{{{exp1}}}"
      }
    },
    "multiply_same_base": {
      "uses": [
        "base",
        "exp1",
        "exp2"
      ],
      "question": {
        "instruction": "Simplify",
        "latex": "{base}^{{{exp1}}}\\cdot {base}^{{{exp2}}}"
      }
    },
    "divide_same_base": {
      "uses": [
        "base",
        "exp1",
        "exp2"
      ],
      "constraints": [
        "exp1 > exp2"
      ],
      "question": {
        "instruction": "Simplify",
        "latex": "\\frac{{{base}^{{{exp1}}}}}{{{base}^{{{exp2}}}}}"
      }
    },
    "power_of_power": {
      "uses": [
        "base",
        "exp1",
        "outer_exp"
      ],
      "question": {
        "instruction": "Simplify",
        "latex": "\\left({base}^{{{exp1}}}\\right)^{{{outer_exp}}}"
      }
    },
    "simplify_monomial_powers": {
      "uses": [
        "coef1",
        "coef2",
        "exp1",
        "exp2",
        "outer_exp"
      ],
      "constraints": [
        "exp1 > exp2"
      ],
      "question": {
        "instruction": "Simplify",
        "latex": "\\frac{{{coef1}x^{{{exp1}}}\\cdot {coef2}x^{{{outer_exp}}}}}{{x^{{{exp2}}}}}"
      }
    },
    "find_missing_exponent": {
      "uses": [
        "base",
        "exp1",
        "exp2"
      ],
      "derived": {
        "target_exp": "exp1 + exp2"
      },
      "question": {
        "instruction": "Find the missing exponent n",
        "latex": "{base}^n\\cdot {base}^{{{exp2}}}={base}^{{{target_exp}}}"
      }
    },
    "scientific_multiply": {
      "uses": [
        "coef1",
        "coef2",
        "ten_exp1",
        "ten_exp2"
      ],
      "constraints": [
        "coef1*coef2 < 100"
      ],
      "question": {
        "instruction": "Write the result in standard scientific notation",
        "latex": "\\left({coef1}\\cdot10^{{{ten_exp1}}}\\right)\\left({coef2}\\cdot10^{{{ten_exp2}}}\\right)"
      },
      "answer_format": "scientific_notation"
    },
    "scientific_divide": {
      "uses": [
        "coef1",
        "coef2",
        "ten_exp1",
        "ten_exp2"
      ],
      "constraints": [
        "coef2 != 0",
        "coef1 % coef2 == 0"
      ],
      "question": {
        "instruction": "Write the result in standard scientific notation",
        "latex": "\\frac{{{coef1}\\cdot10^{{{ten_exp1}}}}}{{{coef2}\\cdot10^{{{ten_exp2}}}}}"
      },
      "answer_format": "scientific_notation"
    },
    "unit_conversion_scientific": {
      "uses": [
        "coef1",
        "ten_exp1",
        "unit_power"
      ],
      "derived": {
        "source_value": "coef1*10**ten_exp1"
      },
      "question": {
        "instruction": "Convert to the smaller unit and write the result in standard scientific notation",
        "latex": "{coef1}\\cdot10^{{{ten_exp1}}}\\ \\text{{m}} = ?\\ \\text{{unit}}"
      },
      "render_context": {
        "unit": {
          "3": "mm",
          "6": "\\mu m",
          "9": "nm"
        }
      },
      "answer_format": "scientific_notation"
    }
  },
  "constraints": [
    "base > 1",
    "exp1 >= 1",
    "exp2 >= 0",
    "coef1 > 0",
    "coef2 > 0"
  ],
  "answer": {
    "type": "symbolic_by_mode",
    "expression": {
      "evaluate_integer_power": "base**exp1",
      "multiply_same_base": "base**(exp1+exp2)",
      "divide_same_base": "base**(exp1-exp2)",
      "power_of_power": "base**(exp1*outer_exp)",
      "simplify_monomial_powers": "coef1*coef2*x**(exp1+outer_exp-exp2)",
      "find_missing_exponent": "exp1",
      "scientific_multiply": "coef1*coef2*10**(ten_exp1+ten_exp2)",
      "scientific_divide": "(coef1/coef2)*10**(ten_exp1-ten_exp2)",
      "unit_conversion_scientific": "coef1*10**(ten_exp1+unit_power)"
    }
  },
  "distractors": {
    "evaluate_integer_power": [
      {
        "id": "multiply_base_exponent",
        "transform": "base*exp1"
      },
      {
        "id": "add_base_exponent",
        "transform": "base+exp1"
      },
      {
        "id": "exponent_off_by_one_low",
        "transform": "base**(exp1-1)"
      },
      {
        "id": "exponent_off_by_one_high",
        "transform": "base**(exp1+1)"
      },
      {
        "id": "square_only",
        "transform": "base**2"
      },
      {
        "id": "base_times_power",
        "transform": "base*(base**(exp1-1)) + 1"
      }
    ],
    "multiply_same_base": [
      {
        "id": "multiply_exponents",
        "transform": "base**(exp1*exp2)"
      },
      {
        "id": "subtract_exponents",
        "transform": "base**abs(exp1-exp2)"
      },
      {
        "id": "keep_first_exponent",
        "transform": "base**exp1"
      },
      {
        "id": "keep_second_exponent",
        "transform": "base**exp2"
      },
      {
        "id": "add_values",
        "transform": "base**exp1 + base**exp2"
      },
      {
        "id": "add_base_and_exponents",
        "transform": "base**(exp1+exp2+1)"
      }
    ],
    "divide_same_base": [
      {
        "id": "add_exponents",
        "transform": "base**(exp1+exp2)"
      },
      {
        "id": "divide_exponents",
        "transform": "base**floor(exp1/exp2)"
      },
      {
        "id": "reverse_subtraction",
        "transform": "base**(exp2-exp1)"
      },
      {
        "id": "keep_numerator_power",
        "transform": "base**exp1"
      },
      {
        "id": "subtract_values",
        "transform": "base**exp1 - base**exp2"
      },
      {
        "id": "off_by_one",
        "transform": "base**(exp1-exp2+1)"
      }
    ],
    "power_of_power": [
      {
        "id": "add_exponents",
        "transform": "base**(exp1+outer_exp)"
      },
      {
        "id": "keep_inner_exponent",
        "transform": "base**exp1"
      },
      {
        "id": "keep_outer_exponent",
        "transform": "base**outer_exp"
      },
      {
        "id": "square_outer_only",
        "transform": "base**(exp1*2)"
      },
      {
        "id": "multiply_base_by_outer",
        "transform": "(base*outer_exp)**exp1"
      },
      {
        "id": "off_by_one_product",
        "transform": "base**(exp1*outer_exp-1)"
      }
    ],
    "simplify_monomial_powers": [
      {
        "id": "subtract_all_exponents",
        "transform": "coef1*coef2*x**(exp1-outer_exp-exp2)"
      },
      {
        "id": "multiply_exponents",
        "transform": "coef1*coef2*x**(exp1*outer_exp-exp2)"
      },
      {
        "id": "forget_denominator_exponent",
        "transform": "coef1*coef2*x**(exp1+outer_exp)"
      },
      {
        "id": "add_denominator_exponent",
        "transform": "coef1*coef2*x**(exp1+outer_exp+exp2)"
      },
      {
        "id": "add_coefficients",
        "transform": "(coef1+coef2)*x**(exp1+outer_exp-exp2)"
      },
      {
        "id": "drop_coefficient_product",
        "transform": "x**(exp1+outer_exp-exp2)"
      }
    ],
    "find_missing_exponent": [
      {
        "id": "target_minus_wrong_side",
        "transform": "exp1+exp2"
      },
      {
        "id": "subtract_target",
        "transform": "abs(exp1-exp2)"
      },
      {
        "id": "use_known_exponent",
        "transform": "exp2"
      },
      {
        "id": "add_one",
        "transform": "exp1+1"
      },
      {
        "id": "subtract_one",
        "transform": "exp1-1"
      },
      {
        "id": "multiply_known_exponents",
        "transform": "exp1*exp2"
      }
    ],
    "scientific_multiply": [
      {
        "id": "subtract_ten_exponents",
        "transform": "coef1*coef2*10**(ten_exp1-ten_exp2)"
      },
      {
        "id": "add_coefficients",
        "transform": "(coef1+coef2)*10**(ten_exp1+ten_exp2)"
      },
      {
        "id": "multiply_exponents",
        "transform": "coef1*coef2*10**(ten_exp1*ten_exp2)"
      },
      {
        "id": "keep_first_power",
        "transform": "coef1*coef2*10**ten_exp1"
      },
      {
        "id": "keep_second_power",
        "transform": "coef1*coef2*10**ten_exp2"
      },
      {
        "id": "off_by_one_power",
        "transform": "coef1*coef2*10**(ten_exp1+ten_exp2+1)"
      }
    ],
    "scientific_divide": [
      {
        "id": "add_ten_exponents",
        "transform": "(coef1/coef2)*10**(ten_exp1+ten_exp2)"
      },
      {
        "id": "reverse_exponent_subtraction",
        "transform": "(coef1/coef2)*10**(ten_exp2-ten_exp1)"
      },
      {
        "id": "multiply_coefficients",
        "transform": "(coef1*coef2)*10**(ten_exp1-ten_exp2)"
      },
      {
        "id": "keep_numerator_power",
        "transform": "(coef1/coef2)*10**ten_exp1"
      },
      {
