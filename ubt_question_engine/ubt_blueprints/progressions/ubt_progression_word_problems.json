  "modes": {
    "arithmetic_word_sum": {
      "uses": [
        "a1",
        "d",
        "n"
      ],
      "question": {
        "instruction": "A hall has a1 seats in the first row, and each next row has d more seats than the previous row. Find the total number of seats in the first n rows.",
        "text_context": {
          "a1": "{a1}",
          "d": "{d}",
          "n": "{n}"
        },
        "latex": "a_1={a1},\\quad d={d},\\quad n={n}"
      }
    },
    "geometric_word_growth": {
      "uses": [
        "g1",
        "q",
        "n"
      ],
      "question": {
        "instruction": "A quantity starts at g1 and is multiplied by q at each step. Find its value at step n.",
        "text_context": {
          "g1": "{g1}",
          "q": "{q}",
          "n": "{n}"
        },
        "latex": "b_1={g1},\\quad q={q},\\quad n={n}"
      }
    }
  },
  "answer": {
    "type": "symbolic_by_mode",
    "expression": {
      "arithmetic_word_sum": "n*(2*a1+(n-1)*d)/2",
      "geometric_word_growth": "g1*q**(n-1)"
    }
  },
  "answer_render": {
    "arithmetic_word_sum": "scalar",
    "geometric_word_growth": "scalar"
  },
  "distractors": {
