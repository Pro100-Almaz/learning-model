      },
      "question": {
        "instruction": "Solve the irrational system",
        "latex": "\\begin{{cases}} \\sqrt{{x}}+\\sqrt{{y}}={sum_pq} \\\\ x-y={diff_sq} \\end{{cases}},\\qquad x\\ge0,\\ y\\ge0"
      }
    },
