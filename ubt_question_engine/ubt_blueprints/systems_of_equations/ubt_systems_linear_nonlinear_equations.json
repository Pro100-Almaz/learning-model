  "modes": {
    "linear_elimination": {
      "uses": [
        "a",
        "b",
        "x0",
        "y0"
      ],
      "constraints": [
        "x0 != y0"
      ],
      "derived": {
        "rhs1": "a*x0+b*y0",
        "rhs2": "a*x0-b*y0"
      },
      "question": {
        "instruction": "Solve the system",
        "latex": "\\begin{{cases}} {a}x+{b}y={rhs1} \\\\ {a}x-{b}y={rhs2} \\end{{cases}}"
      }
    },
    "linear_general": {
      "uses": [
        "a",
        "b",
        "c",
        "d",
        "x0",
        "y0"
      ],
      "constraints": [
        "a*d-b*c != 0",
        "x0 != y0"
      ],
      "derived": {
        "rhs1": "a*x0+b*y0",
        "rhs2": "c*x0+d*y0"
      },
      "question": {
        "instruction": "Solve the system",
        "latex": "\\begin{{cases}} {a}x+{b}y={rhs1} \\\\ {c}x+{d}y={rhs2} \\end{{cases}}"
      }
    },
    "nonlinear_sum_product": {
      "uses": [
        "r1",
        "r2"
      ],
      "constraints": [
        "r1 != r2",
        "r1 != 0",
        "r2 != 0"
      ],
      "derived": {
        "sum_roots": "r1+r2",
        "product_roots": "r1*r2"
      },
      "question": {
        "instruction": "Solve the nonlinear system",
        "latex": "\\begin{{cases}} x+y={sum_roots} \\\\ xy={product_roots} \\end{{cases}}"
      }
    },
    "nonlinear_difference_squares": {
      "uses": [
        "x0",
        "y0"
      ],
      "constraints": [
        "x0 != y0",
        "x0+y0 != 0"
      ],
      "derived": {
        "sum_xy": "x0+y0",
        "difference_squares": "x0**2-y0**2"
      },
      "question": {
        "instruction": "Solve the nonlinear system",
        "latex": "\\begin{{cases}} x+y={sum_xy} \\\\ x^2-y^2={difference_squares} \\end{{cases}}"
      }
    },
    "line_parabola_intersection": {
      "uses": [
        "r1",
        "r2",
        "shift"
      ],
      "constraints": [
        "r1 != r2",
        "r1+r2 != 0"
      ],
      "derived": {
        "sum_roots": "r1+r2",
        "product_roots": "r1*r2",
        "line_constant": "shift-r1*r2"
      },
      "question": {
        "instruction": "Solve the nonlinear system",
        "latex": "\\begin{{cases}} y=x^2{shift:+d} \\\\ y={sum_roots}x{line_constant:+d} \\end{{cases}}"
      }
    },
    "circle_line_intersection": {
      "uses": [
        "x0",
        "y0"
      ],
      "constraints": [
        "x0 != y0",
        "x0+y0 != 0"
      ],
      "derived": {
        "sum_xy": "x0+y0",
        "radius_sq": "x0**2+y0**2"
      },
      "question": {
        "instruction": "Solve the nonlinear system",
        "latex": "\\begin{{cases}} x+y={sum_xy} \\\\ x^2+y^2={radius_sq} \\end{{cases}}"
      }
    }
  },
